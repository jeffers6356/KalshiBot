{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalshibot",
  "main": "worker.py",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": false
  }
}
